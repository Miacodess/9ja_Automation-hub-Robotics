true,"lockChildren":true,"parameters":{"name":"My Program"}},"guid":"f1288c27-9456-ad15-3913-ee05a09d4da8"},"programInformation":{"name":"9ja_Automation_Pick_n_Place","description":"","programState":"DRAFT","functionsBlockShown":false,"createdDate":1740503439905,"lastSavedDate":1752009024445,"lastModifiedDate":1789657851231},"urscript":{"script":"global BlockConv_Pick_Approach = struct(p=p[-0.002780322424561278, -0.5542415633220559, 0.12091810871392816, -2.1866118550585756, 2.2216427796420173, -0.00586281165502878], frame=\"base\", q=[-1.3422060740963886, -1.8632064729342694, -1.8989434075930385, -0.9597523070104792, 1.5935591024662283, -1.326421356617665])\nglobal BlockConv_Pick = struct(p=p[-0.0027803224595693873, -0.5542415630579547, 0.015292737944650359, -2.1866118550585734, 2.221642779642032, -0.005862811655080313], frame=\"base\", q=[-1.342206074088848, -2.046198763139941, -1.984702482267532, -0.6910009421301027, 1.5935591024663154, -1.326421356610112])\nglobal BoxConv_Approach = struct(p=p[0.024648832376718985, 0.5649288325446853, 0.3608605211570737, 2.1875019472917705, 2.258963730782179, -0.03846783678627329], frame=\"base\", q=[1.756463041791827, -1.7155670060111436, -1.4298749800306645, -1.5784886714505673, 1.5926008806821308, -1.4173958660460837])\nglobal BoxConv = struct(p=p[0.024648832376726895, 0.564928832544866, 0.09794674112144197, 2.187501947291823, 2.2589637307822774, -0.038467836786054914], frame=\"base\", q=[1.7564630416943199, -1.9208141993267898, -1.889313848330815, -0.9138026098366465, 1.5926008806808944, -1.4173958661436288])\n$ 1 \"My Program\"\n$ 2 \"Modules\"\n$ 3 \"ur_recordings\"\n$ 4 \"Block\"\n$ 5 \"\"\ndef Block_Create():\n  $ 6 \"\"\n  set_standard_digital_out(0,True)\n  $ 7 \"1.00 s\"\n  sleep(1)\n  $ 8 \"\"\n  set_standard_digital_out(0,False)\nend\n$ 9 \"\"\ndef Block_Reset():\n  $ 10 \"\"\n  set_standard_digital_out(0,False)\n  $ 11 \"1.00 s\"\n  sleep(1)\nend\n$ 12 \"\"\ndef Block_Simulate():\n  $ 13 \"BlockScript\"\n  thread BlockConveyorThread():\n      while(True):\n          Block_Create()\n          BlockConveyor_WaitForBlock()\n          BlockConveyor_WaitUntilBlockPicked()\n          sync()\n      end\n  end\n  BlockConveyorThread_handler = run BlockConveyorThread()\nend\n$ 14 \"Robot\"\n$ 15 \"\"\ndef Robot_Pick():\n  $ 16 \"\"\n  set_tcp(p[0, 0, 0.115, 0, 0, 0], \"TCP_SimpleGripper_1\")\n  optimovej(get_inverse_kin(convert_pose(BlockConv_Pick_Approach.p, BlockConv_Pick_Approach.frame, \"base\"), qnear=BlockConv_Pick_Approach.q), a=0.25, v=0.5)\n  $ 17 \"\"\n  while (get_standard_digital_in(0) == False):\n    sync()\n  end\n  $ 18 \"\"\n  set_tcp(p[0, 0, 0.115, 0, 0, 0], \"TCP_SimpleGripper_1\")\n  optimovel(convert_pose(BlockConv_Pick.p, BlockConv_Pick.frame, \"base\"), a=0.09, v=0.3)\n  $ 19 \"\"\n  set_tool_digital_out(0,False)\n  set_tool_digital_out(1,True)\n  $ 20 \"\"\n  set_target_payload(1.1, [0, 0, 0])\n  $ 21 \"2.00 s\"\n  sleep(2)\n  $ 22 \"\"\n  optimovel(convert_pose(BlockConv_Pick_Approach.p, BlockConv_Pick_Approach.frame, \"base\"), a=0.25, v=0.5)\nend\n$ 23 \"\"\ndef Robot_Place():\n  $ 24 \"\"\n  set_tcp(p[0, 0, 0.115, 0, 0, 0], \"TCP_SimpleGripper_1\")\n  optimovej(get_inverse_kin(convert_pose(BoxConv_Approach.p, BoxConv_Approach.frame, \"base\"), qnear=BoxConv_Approach.q), a=0.25, v=0.5)\n  $ 25 \"\"\n  while (get_standard_digital_in(1) == False):\n    sync()\n  end\n  $ 26 \"\"\n  set_tcp(p[0, 0, 0.115, 0, 0, 0], \"TCP_SimpleGripper_1\")\n  optimovel(convert_pose(BoxConv.p, BoxConv.frame, \"base\"), a=0.09, v=0.3)\n  $ 27 \"\"\n  set_tool_digital_out(0,True)\n  set_tool_digital_out(1,False)\n  $ 28 \"\"\n  set_target_payload(0.122366, [-8.271806125530239e-21, 4.776114657058022e-19, 0.002001356682800776], [0.00008452945323247324, 0.00008048281915663539, 0.00006969117649936129, -1.9386991750998697e-23, 2.212702009854895e-22, -1.6766150729520216e-21])\n  $ 29 \"1.00 s\"\n  sleep(1)\n  $ 30 \"\"\n  optimovel(convert_pose(BoxConv_Approach.p, BoxConv_Approach.frame, \"base\"), a=0.25, v=0.5)\nend\n$ 31 \"Box\"\n$ 32 \"\"\ndef Box_Create():\n  $ 33 \"\"\n  set_standard_digital_out(1,True)\n  $ 34 \"1.00 s\"\n  sleep(1)\n  $ 35 \"\"\n  set_standard_digital_out(1,False)\nend\n$ 36 \"\"\ndef Box_Reset():\n  $ 37 \"\"\n  set_standard_digital_out(1,False)\n  $ 38 \"1.00 s\"\n  sleep(1)\nend\n$ 39 \"\"\ndef Box_Simulate():\n  $ 40 \"BoxScript\"\n  thread BoxConveyorThread():\n      while(True):\n          BoxConveyor_Start()\n          Box_Create()\n          BoxConveyor_WaitForBox()\n          BoxConveyor_Stop()\n          BoxConveyor_WaitUntilBlockPlaced()\n          partInBox = False\n          BoxConveyor_Start()\n          BoxConveyor_WaitUntilBoxLeft()\n          sync()\n      end\n  end\n  BoxConveyorThread_handler = run BoxConveyorThread()\nend\n$ 41 \"BoxConveyor\"\n$ 42 \"\"\ndef BoxConveyor_Start():\n  $ 43 \"\"\n  set_standard_digital_out(2,False)\nend\n$ 44 \"\"\ndef BoxConveyor_Stop():\n  $ 45 \"\"\n  set_standard_digital_out(2,True)\nend\n$ 46 \"\"\ndef BoxConveyor_WaitForBox():\n  $ 47 \"\"\n  while (get_standard_digital_in(1) == False):\n    sync()\n  end\nend\n$ 48 \"\"\ndef BoxConveyor_WaitUntilBoxLeft():\n  $ 49 \"\"\n  while (get_standard_digital_in(1) == True):\n    sync()\n  end\nend\n$ 50 \"\"\ndef BoxConveyor_WaitUntilBlockPlaced():\n  $ 51 \"WaitUntilBlockPlacedScript\"\n  while (partInBox == False):\n      sync()\n  end\nend\n$ 52 \"BlockConveyor\"\n$ 53 \"\"\ndef BlockConveyor_WaitForBlock():\n  $ 54 \"\"\n  while (get_standard_digital_in(0) == False):\n    sync()\n  end\nend\n$ 55 \"\"\ndef BlockConveyor_WaitUntilBlockPicked():\n  $ 56 \"\"\n  while (get_standard_digital_in(0) == True):\n    sync()\n  end\nend\n$ 57 \"\"\n$ 58 \"Before Start\"\n$ 59 \"blocks_n_box:0\"\nglobal blocks_n_box = 0\n$ 60 \"partInBox:False\"\nglobal partInBox = False\n$ 61 \"\"\nset_tool_digital_out(0,True)\nset_tool_digital_out(1,False)\n$ 62 \"BlockReset\"\nBlock_Reset()\n$ 63 \"BoxReset\"\nBox_Reset()\n$ 64 \"BlockSimulate\"\nBlock_Simulate()\n$ 65 \"BoxSimulate\"\nBox_Simulate()\n$ 66 \"\"\nwhile (True):\n  $ 67 \"RobotPick\"\n  Robot_Pick()\n  $ 68 \"RobotPlace\"\n  Robot_Place()\n  $ 69 \"blocks_n_box:blocks_n_box + 1\"\n  blocks_n_box = blocks_n_box + 1\n  $ 70 \"blocks_n_box == 5\"\n  if (blocks_n_box == 5):\n    $ 71 \"partInBox:False\"\n    partInBox = False\n    $ 72 \"\"\n    set_standard_digital_out(2,False)\n    $ 73 \"\"\n    while (get_standard_digital_in(1) == True):\n      sync()\n    end\n    $ 74 \"partInBox:True\"\n    partInBox = True\n    $ 75 \"\"\n    set_standard_digital_out(2,True)\n    $ 76 \"BoxCreate\"\n    Box_Create()\n    $ 77 \"\"\n    while (get_standard_digital_in(1) == False):\n      sync()\n    end\n    $ 78 \"blocks_n_box:0\"\n    blocks_n_box = 0\n  end\nend","nodeIDList":["00000000-0000-0000-0000-000000000000","f1288c27-9456-ad15-3913-ee05a09d4da8","2717b093-29bc-9da0-a787-820d4223f5d9","e47b5767-640b-1cae-aad6-64f3f792a00e","7d3fce24-812e-5726-3273-828686b97ad2","986e91b8-c45f-aaa5-1f76-781d61a4f242","7f534a36-6f6c-6aca-32e9-e443540eb1bb","b0063644-d6a6-23ee-c050-16eb7f6ab102","2f3eb94c-a5d3-01e3-8e67-e4295ac751ab","4ea88a0d-7db0-d51f-3a53-7e2e854ca62d","6cb697d5-f6cd-5d54-0f43-929c181b0a52","95279187-e38c-1392-2b25-80bdda22af1c","82b72232-7c50-442a-d8d8-3c81063206e3","274dcaba-a73c-037b-4da4-7d33a0b8371e","8c7fa262-669e-ca71-f3d9-7787af83c469","a463d50e-4dce-e742-f071-8fdd8673bfb8","5d78f964-ea4e-3d8b-79b5-d3ea630e9cfe","085519ff-5b83-64fb-3b29-fd158bf3631f","4b4bd9cc-c3c1-59cb-6314-a06df4e18d2f","3b03b9a1-30f6-0f38-81e2-2a9cf6eeedab","35465d7d-a753-0d61-8a67-44b454bfdd03","3346bc68-3658-2252-ebda-6d34a7a65a43","e82cdf7c-30b0-cc81-ea2e-2922db41dd41","ada57b89-8fc1-d319-6a60-91841c8e7e0f","444563d9-b1e9-cea7-53b6-78ea15218754","48539fc5-f65e-9220-ec45-2c423567e6b9","c0c27879-71de-9fbc-4bfb-3486cb4f4322","07109862-a07f-5214-0896-a9de7cfea282","c4a3763d-6c81-52c3-aa52-7b5ff4ec55ff","03374ffd-c219-0d2b-1023-9d31f14af8eb","b8f8309e-fb63-18f1-fc10-bbeb6f