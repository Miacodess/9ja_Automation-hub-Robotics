04530589296885899, 1.2371750417659376e-06, 7.418886500618058e-08, 2.1389086480268416e-06])\n    $ 21 \"setGripper1Open\"\n    setGripper1Open()\n    $ 22 \"movej: Home\"\n    movej([1.0605, -1.6588, 1.6184, -0.8402, -0.8510, -0.2797])\n    $ 23 \"Approach infeed\"\n    movej([1.443, -1.054, 1.185, -1.541, -0.539, 2.948], a=1, v=1)\n    $ 24 \"movej: Pick part\"\n    movej([1.431, -0.904, 1.398, -1.884, -0.541, 2.926], a=1, v=1)\n    $ 25 \"setGripper1Closed\"\n    setGripper1Closed()\n    $ 26 \"3.00 s\"\n    sleep(3)\n    $ 27 \"Approach infeed\"\n    movej([1.443, -1.054, 1.185, -1.541, -0.539, 2.948], a=1, v=1)\n    $ 28 \"Avoid door\"\n    movej([0.9443, -1.4817, 1.598, -1.1704, -1.135, -0.4419])\n    $ 29 \"Approach door\"\n    movej([0.3175, -1.7143, 1.9203, -1.2428, -1.682, -1.002])\n    $ 30 \"Inside machine\"\n    movej([-.202, -.796, 1.026, -1.706, -1.040, -0.212])\n    $ 31 \"Place part\"\n    movej([0.057, -0.723, 0.927, -1.834, -1.035, 0.09])\n    $ 32 \"\"\n    set_standard_digital_out(1,True)\n    $ 33 \"1.00 s\"\n    sleep(1)\n    $ 34 \"setGripper1Open\"\n    setGripper1Open()\n    $ 35 \"3.00 s\"\n    sleep(3)\n    $ 36 \"Inside machine\"\n    movej([-.202, -.796, 1.026, -1.706, -1.040, -0.212])\n    $ 37 \"Approach door\"\n    movej([0.3175, -1.7143, 1.9203, -1.2428, -1.682, -1.002])\n    $ 38 \"Home pose\"\n    movej([1.0612, -1.6587, 1.6199, -0.8406, -0.8513, -0.2794])\n    $ 39 \"\"\n    set_standard_digital_out(2,True)\n    $ 40 \"1.00 s\"\n    sleep(1)\n    $ 41 \"Execute_CNC_machining\"\n    Execute_CNC_machining()\n    $ 42 \"1.00 s\"\n    sleep(1)\n    $ 43 \"Unload_Machine\"\n    $ 44 \"\"\n    set_standard_digital_out(2,False)\n    $ 45 \"1.00 s\"\n    sleep(1)\n    $ 46 \"Home pose\"\n    movej([1.0612, -1.6587, 1.6199, -0.8406, -0.8513, -0.2794])\n    $ 47 \"Approach door\"\n    movej([0.3175, -1.7143, 1.9203, -1.2428, -1.682, -1.002])\n    $ 48 \"Inside machine\"\n    movej([-.202, -.796, 1.026, -1.706, -1.040, -0.212])\n    $ 49 \"Remove part\"\n    movej([0.057, -0.718, 0.939, -1.851, -1.035, 0.09])\n    $ 50 \"setGripper1Closed\"\n    setGripper1Closed()\n    $ 51 \"3.00 s\"\n    sleep(3)\n    $ 52 \"\"\n    set_standard_digital_out(1,False)\n    $ 53 \"3.00 s\"\n    sleep(3)\n    $ 54 \"Inside machine\"\n    movej([-.202, -.796, 1.026, -1.706, -1.040, -0.212])\n    $ 55 \"Approach door\"\n    movej([0.3175, -1.7143, 1.9203, -1.2428, -1.682, -1.002])\n    $ 56 \"Approach tray\"\n    movej([2.874, -1.614,1.613,-2.591,-1.360,-1.708])\n    $ 57 \"Approach slot\"\n    movej([3.128,-1.433,1.684,-2.857,-1.578,-1.577])\n    $ 58 \"Place slot\"\n    movej([3.122,-1.090,2.009,-3.524,-1.574,-1.579])\n    $ 59 \"setGripper1Open\"\n    setGripper1Open()\n    $ 60 \"3.00 s\"\n    sleep(3)\n    $ 61 \"Approach slot\"\n    movej([3.128,-1.433,1.684,-2.857,-1.578,-1.577])\n    $ 62 \"Approach tray\"\n    movej([2.874, -1.614,1.613,-2.591,-1.360,-1.708])\n    $ 63 \"parts_machined:parts_machined + 1\"\n    parts_machined = parts_machined + 1\n  end\nend","nodeIDList":["00000000-0000-0000-0000-000000000000","1768597b-899e-6a9e-5cf6-9f60ac4f55c4","5ed52d7f-91b2-0c73-0aea-f82c2bb370cd","3696790d-cc34-9335-7e0a-37c32c0ba3ee","8b8a3cd9-a75d-4e9c-3aae-c16d29a767c3","4f843d80-b6c1-106b-47db-42b715b2a36e","5e76c43e-0135-c26f-d206-d7f8dd286671","83533171-262d-6ca5-1ab1-0e6cb5afaaaa","0601e5c0-108a-9246-f74f-c7192aac0e4b","c95f87a3-008f-8a12-c48a-ae51812491a7","dcbcca66-268b-0d86-27b5-0bc056ffb790","6a50c6d9-518c-4f6c-fb18-43ca62a285f3","cb3e94bc-2e50-bdc3-ab6e-956d764f9f4c","a833800d-1b48-a4c5-7fb3-92d735123f61","0d5411ec-61c0-ad02-8df7-49fd026c34ca","74454594-a455-0039-07ff-6ea5673f6070","0055afd2-3a02-d245-4089-9cc12bc2505e","cabe6680-0488-a405-4043-fdc9a502fce3","d0c6b0cf-e231-310e-7c9c-c0127729c283","50399cbf-943e-2c02-404e-924621419bf6","0fdc0aab-5943-8f2c-d579-d6ba63f415a0","030bdbd2-56a3-eea8-702c-1a9729b98d1e","cbb7d390-186a-6937-baa3-2b85072abd9b","c2f152ee-6fdd-3af2-b008-b988be609144","c792c12c-ee41-a805-730